  Base -> User [dir=back, arrowtail=normal, arrowhead=none, color="#7f848e", weight=5];
  IdMixin -> Board [dir=back, arrowtail=normal, arrowhead=none, style=dashed, color="#7f848e", weight=2];
  TimestampMixin -> Board [dir=back, arrowtail=normal, arrowhead=none, style=dashed, color="#7f848e", weight=2];
  IdMixin -> ScheduleBoardTask [dir=back, arrowtail=normal, arrowhead=none, style=dashed, color="#7f848e", weight=2];
