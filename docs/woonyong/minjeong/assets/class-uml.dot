  { rank=same; Base; IdMixin; TimestampMixin; }
  { rank=same; Board; BoardTypeConstants; ScheduleBoardDetail; ScheduleBoardTask; ProceedingsBoardDetail; BoardCarbonCopy; BoardAssignee; BoardParticipant; User; }
  ScheduleBoardDetail -> ScheduleBoardTask [style=invis, weight=20];
  ScheduleBoardTask -> ProceedingsBoardDetail [style=invis, weight=20];
  ProceedingsBoardDetail -> BoardCarbonCopy [style=invis, weight=20];
  BoardCarbonCopy -> BoardAssignee [style=invis, weight=20];
  BoardAssignee -> BoardParticipant [style=invis, weight=20];
  BoardParticipant -> User [style=invis, weight=20];

  Base -> Board [dir=back, arrowtail=normal, arrowhead=none, color="#7f848e", weight=5];
  Base -> ScheduleBoardDetail [dir=back, arrowtail=normal, arrowhead=none, color="#7f848e", weight=5];
  Base -> ScheduleBoardTask [dir=back, arrowtail=normal, arrowhead=none, color="#7f848e", weight=5];
