REPOLM_ENV=local
POSTGRES_USER=repolm
POSTGRES_PASSWORD=repolm
POSTGRES_DB=repolm
# 앱은 동기 SQLAlchemy(psycopg)를 쓴다. 비우면 in-memory 모드로 동작.
POSTGRES_DATABASE_URL=postgresql+psycopg://repolm:repolm@postgres:5432/repolm
NEXT_PUBLIC_API_URL=http://localhost:8000
# Vercel 배포 시에는 브라우저가 공개 터널 도메인을 직접 호출하지 않도록
# Next.js rewrites를 통해 프록시한다.
# 예: NEXT_PUBLIC_API_URL=/api/backend
# 예: BACKEND_PROXY_URL=https://api.example.com

# GitHub 웹훅(선택): push→sync 트리거에만 사용.
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth 로그인 (GitHub App 또는 OAuth App의 Client ID/Secret).
# 콜백 URL은 GitHub 앱 설정의 Authorization callback URL과 정확히 일치해야 함.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
SESSION_JWT_SECRET=change-me-to-a-long-random-string
WEB_APP_URL=http://localhost:3000
# Vercel preview URL 등 WEB_APP_URL 외 origin을 쉼표로 추가한다.
# 예: CORS_EXTRA_ORIGINS=https://repolm-git-main-your-team.vercel.app
CORS_EXTRA_ORIGINS=

# AI provider keys must stay out of Git. Put real values in .env.
OPENAI_API_KEY=

# 산출물(UML/ERD/의존성/변경요약) 컨텍스트 수집 한도(선택). 비우면 코드 기본값 사용.
# 키울수록 더 많은 코드 맥락으로 정확도↑, 단 LLM 비용/지연↑.
ARTIFACT_MAX_FILE_CHARS=4000
ARTIFACT_MAX_TOTAL_CONTEXT_CHARS=20000
ARTIFACT_MAX_SELECTED_FILES=60
ARTIFACT_MAX_DEPENDENCY_FILES=250

# 채팅 RAG 검색 top_k(선택). 비우면 코드 기본값 사용.
CHAT_DEFAULT_TOP_K=5
CHAT_ARCHITECTURE_TOP_K=8

# 채팅 에이전트 도구 사용(인프로세스: 소스 파일 읽기·코드 검색·심볼 찾기). 기본 ON.
# 끄려면 false. 도구 호출 반복 상한도 조절 가능.
CHAT_USE_TOOLS=true
CHAT_TOOL_MAX_STEPS=4
