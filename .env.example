REPOPILOT_ENV=local
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot
POSTGRES_DB=repopilot
DATABASE_URL=postgresql+asyncpg://repopilot:repopilot@postgres:5432/repopilot
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub App values are intentionally blank for local planning.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# AI provider keys must stay out of Git. Put real values in .env.
OPENAI_API_KEY=

