meta {
  name: Update Board
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/board/{{boardId}}
  body: json
  auth: none
}

body:json {
  {
    "board_type": 1,
    "title": "Bruno updated board",
    "content": "Board updated from Bruno collection.",
    "tag": "bruno-updated",
    "user_id": 1,
    "assignee_user_ids": [],
    "participant_user_ids": [],
    "carbon_copy_user_ids": []
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("title is updated", function() {
    expect(res.getBody().title).to.equal("Bruno updated board");
  });
}
