meta {
  name: Create Proceedings Board
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/board/
  body: json
  auth: none
}

body:json {
  {
    "board_type": 3,
    "title": "Bruno proceedings board",
    "content": "Proceedings board created from Bruno collection.",
    "tag": "bruno-proceedings",
    "user_id": 1,
    "assignee_user_ids": [],
    "participant_user_ids": [1],
    "carbon_copy_user_ids": [],
    "proceedings_board_detail": {
      "meeting_date": "2026-06-15T12:00:00"
    }
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("proceedings detail is saved", function() {
    expect(res.getBody()).to.have.property("proceedings_board_detail");
  });
}
