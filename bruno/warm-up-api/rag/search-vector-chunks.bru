meta {
  name: Search Vector Chunks
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/rag/vector/search
  body: json
  auth: none
}

body:json {
  {
    "query": "code evidence reliable work plans",
    "limit": 3
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has vector search schema", function() {
    const body = res.getBody();
    expect(body).to.have.property("collection");
    expect(body).to.have.property("count");
    expect(body).to.have.property("query");
    expect(body).to.have.property("items");
  });
}
